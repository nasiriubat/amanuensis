\documentclass[sigconf]{acmart}
\usepackage{booktabs}
\usepackage{longtable}
\usepackage{xcolor}
\providecommand{\pandocbounded}[1]{#1}
\usepackage{graphicx}
\setkeys{Gin}{width=\linewidth,keepaspectratio}
\providecommand{\tightlist}{\setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}
\newcommand{\needs}[1]{\textcolor{red}{\textbf{[NEEDS: #1]}}}
\newcommand{\citeneeded}[1]{\textcolor{red}{\textbf{[CITE: #1]}}}

\settopmatter{printacmref=false}
\renewcommand\footnotetextcopyrightpermission[1]{}
\setcopyright{none}
<# The running header shows the venue you chose; acmart's sample "Conference'17" otherwise. #>
<% if venue %>\acmConference[<< venue >>]{<< venue >>}{}{}<% else %>\acmConference{}{}{}<% endif %>
\pagestyle{plain}

\begin{document}

\title{<< title >>}
<% if subtitle %>\subtitle{<< subtitle >>}<% endif %>
<% for a in authors %>
\author{<< a.name >>}
<% if a.orcid %>\orcid{<< a.orcid >>}<% endif %>
<% if a.email %>\email{<< a.email >>}<% endif %>
\affiliation{
  \institution{<< a.affiliation or "" >>}
  \country{<< a.country or "" >>}
}
<% endfor %>

<% if abstract %>
\begin{abstract}
<< abstract >>
\end{abstract}
<% endif %>

<% if keywords_csv %>\keywords{<< keywords_csv >>}<% endif %>

\maketitle
<# acmart switches to its running header inside \maketitle; with no date or location it prints
   "venue, , authors". Page numbers only until the camera-ready fills in the conference block. #>
\pagestyle{plain}

<< body >>

<% if has_bib %>
\bibliographystyle{ACM-Reference-Format}
\bibliography{refs}
<% endif %>

\end{document}
