# Copy to .env and edit. Only bootstrap settings live here; everything else is configured in the admin UI.

# Required. Encrypts provider API keys at rest and signs sessions. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=change-me

# First admin account, created on first boot only. Change the password from the profile menu afterwards.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-too

# Where projects, profiles, templates and the SQLite database live. Mounted as a volume in Docker.
DATA_DIR=./data

# Public URL of the app, used for cookie security. Use https://... in production.
APP_URL=http://localhost:8000

# Set to "true" behind HTTPS so cookies are marked Secure.
SECURE_COOKIES=false
